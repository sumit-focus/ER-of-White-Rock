---
interface Diagnostic {
    name: string;
    description?: string;
    icon?: string;
}

interface Props {
    data: {
        title?: string;
        description?: string;
        diagnostics?: Diagnostic[];
    };
}

const { data } = Astro.props;
if (!data) return null;
---

<section class="py-16 lg:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-12">
        {
            data.title && (
                <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4 text-center">
                    {data.title}
                </h2>
            )
        }
        {
            data.description && (
                <p class="text-lg text-gray-600 mb-10 text-center max-w-3xl mx-auto">
                    {data.description}
                </p>
            )
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
                data.diagnostics?.map((d, i) => (
                    <div class="flex gap-5 items-start p-6 rounded-xl bg-blue-50/50 border border-blue-100">
                        <div class="flex-shrink-0 w-14 h-14 rounded-full bg-primary flex items-center justify-center">
                            {d.icon ? (
                                <span class="material-symbols-outlined text-2xl text-white">
                                    {d.icon}
                                </span>
                            ) : (
                                <span class="text-white font-bold text-lg">
                                    {i + 1}
                                </span>
                            )}
                        </div>
                        <div>
                            <h3 class="font-bold text-gray-900 text-lg mb-1">
                                {d.name}
                            </h3>
                            {d.description && (
                                <p class="text-gray-600 text-sm leading-relaxed">
                                    {d.description}
                                </p>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
