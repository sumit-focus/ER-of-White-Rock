---
import Layout from "../../layouts/Layout.astro";
import { client, urlFor } from "../../lib/sanity";
import { PortableText } from "astro-portabletext";

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect("/404");
}

const physician = await client.fetch(
    `*[_type == "physician" && slug.current == $slug][0] {
    name,
    title,
    credentials,
    bio,
    headshot,
    "reviewedPosts": *[_type == "post" && references(^._id)] {
      title,
      slug,
      publishedAt
    }
  }`,
    { slug },
);

if (!physician) {
    return Astro.redirect("/404");
}

const schema = {
    "@context": "https://schema.org",
    "@type": "Physician",
    name: physician.name,
    medicalSpecialty: "Emergency Medicine",
    image: physician.headshot ? urlFor(physician.headshot).url() : undefined,
    jobTitle: physician.title,
    description: `Board-certified physician at ER of White Rock.`,
};
---

<Layout title={`${physician.name} - ${physician.title} | ER of White Rock`}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <div class="bg-gray-50 min-h-screen py-24">
        <div class="max-w-4xl mx-auto px-6 lg:px-8">
            <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
                <div
                    class="p-8 md:p-12 flex flex-col md:flex-row gap-12 items-start"
                >
                    {/* Headshot */}
                    <div class="shrink-0 w-full md:w-1/3">
                        {
                            physician.headshot ? (
                                <img
                                    src={urlFor(physician.headshot)
                                        .width(600)
                                        .height(800)
                                        .url()}
                                    alt={physician.name}
                                    class="w-full rounded-2xl shadow-lg object-cover aspect-[3/4]"
                                />
                            ) : (
                                <div class="w-full rounded-2xl bg-gray-200 aspect-[3/4] flex items-center justify-center text-gray-400">
                                    <span class="material-symbols-outlined text-6xl">
                                        person
                                    </span>
                                </div>
                            )
                        }
                    </div>

                    {/* Info */}
                    <div class="flex-grow">
                        <h1 class="text-4xl font-bold text-gray-900 mb-2">
                            {physician.name}
                        </h1>
                        <p class="text-xl text-primary font-bold mb-6">
                            {physician.title}
                            <span class="text-gray-300">|</span>
                            {physician.credentials}
                        </p>

                        <div
                            class="prose prose-blue max-w-none mb-10 text-gray-600 leading-relaxed"
                        >
                            <PortableText value={physician.bio} />
                        </div>

                        {/* Articles Reviewed */}
                        {
                            physician.reviewedPosts &&
                                physician.reviewedPosts.length > 0 && (
                                    <div class="border-t border-gray-100 pt-8">
                                        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                                            <span class="material-symbols-outlined text-primary">
                                                verified_user
                                            </span>
                                            Medically Reviewed by{" "}
                                            {physician.name.split(" ")[0]}
                                        </h3>
                                        <ul class="space-y-3">
                                            {physician.reviewedPosts.map(
                                                (post: any) => (
                                                    <li>
                                                        <a
                                                            href={`/blog/${post.slug.current}`}
                                                            class="text-gray-600 hover:text-primary transition-colors flex items-center gap-2 group"
                                                        >
                                                            <span class="w-1.5 h-1.5 rounded-full bg-gray-300 group-hover:bg-primary transition-colors" />
                                                            {post.title}
                                                        </a>
                                                    </li>
                                                ),
                                            )}
                                        </ul>
                                    </div>
                                )
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>
